# Lemma Subnet Configuration
# Copy this file to .env and update the values

# Network Configuration
NETWORK=finney          # finney (mainnet), test (testnet), or local
NETUID=1                # Your subnet's netuid

# Wallet Configuration
WALLET_NAME=default     # Name of your wallet
HOTKEY_NAME=default     # Name of your hotkey

# Logging
LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR

# Lemma scoring/requests
EMA_ALPHA=0.35
MINER_REQUEST_TIMEOUT=45
LEAN_TIMEOUT_SECONDS=30
MAX_RESPONSE_CHARS=16000
MAX_PROOF_CHARS_FOR_SCORING=12000
MAX_PROOF_LINES=300
MAX_IMPORT_LINES=4
CHALLENGE_BATCH_SIZE=6
DIFFICULTY_WEIGHTING_ENABLED=true
LEAN_MEMORY_LIMIT_MB=1024
COMMITMENT_REFRESH_BLOCKS=20
ROUND_LOG_PATH=data/round_results.jsonl
EPISTULA_SIGN_REQUESTS=true
EPISTULA_VERIFY_RESPONSES=true
EPISTULA_STRICT_VERIFY=true
EPISTULA_MAX_SKEW_SECONDS=60
METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
METRICS_PORT=9109

# Explicit uid->endpoint mapping consumed by validator.py
# Format: uid=url,uid=url
# This overrides on-chain commitments for matching UIDs.
MINER_ENDPOINTS=2=http://127.0.0.1:8081,3=http://127.0.0.1:8082

# Optional local stub-miner compose settings
MINER1_WALLET_NAME=default
MINER1_HOTKEY_NAME=miner1
MINER2_WALLET_NAME=default
MINER2_HOTKEY_NAME=miner2
MINER3_WALLET_NAME=default
MINER3_HOTKEY_NAME=miner3
VERIFY_VALIDATOR_EPISTULA=false
